# Copy to .env.local and fill in values. Never commit .env.local.
# Never put a service_role key anywhere in this project.

# --- Supabase > Project Settings > API ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Python tests (optional; read by tests/test_config.py) ---
RUN_INTEGRATION_TESTS=1
TEST_BASE_URL=http://localhost:3000
TEST_ADMIN_EMAIL=admin@yourdomain.com
TEST_ADMIN_PASSWORD=choose-a-password
TEST_TRAINER_EMAIL=trainer@yourdomain.com
TEST_TRAINER_PASSWORD=choose-a-password
TEST_CUSTOMER_EMAIL=customer@yourdomain.com
TEST_CUSTOMER_PASSWORD=choose-a-password
